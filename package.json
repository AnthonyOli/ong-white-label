{
  "name": "ong-white-label",
  "version": "1.0.0",
  "description": "This project was bootstrapped with Fastify-CLI.",
  "main": "app.ts",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "npm run build:ts && tsc -p test/tsconfig.json && c8 node --test -r ts-node/register \"test/**/*.ts\"",
    "start": "npm run build:ts && fastify start -l info dist/app.js",
    "build:ts": "tsc",
    "watch:ts": "tsc -w",
    "dev": "npm run build:ts && concurrently -k -p \"[{name}]\" -n \"TypeScript,App\" -c \"yellow.bold,cyan.bold\" \"npm:watch:ts\" \"npm:dev:start\"",
    "dev:start": "fastify start --ignore-watch=.ts$ -w -l info -P dist/app.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnthonyOli/ong-white-label.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/AnthonyOli/ong-white-label/issues"
  },
  "homepage": "https://github.com/AnthonyOli/ong-white-label#readme",
  "dependencies": {
    "@fastify/autoload": "^6.0.0",
    "@fastify/postgres": "^6.0.2",
    "@fastify/sensible": "^6.0.0",
    "@prisma/client": "^6.18.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.0.0",
    "fastify-cli": "^7.4.0",
    "fastify-plugin": "^5.0.0",
    "pg": "^8.16.3",
    "prisma-cli": "^1.0.9"
  },
  "devDependencies": {
    "@types/node": "^22.1.0",
    "c8": "^10.1.2",
    "concurrently": "^9.0.0",
    "dotenv-cli": "^11.0.0",
    "fastify-tsconfig": "^3.0.0",
    "prisma": "^6.18.0",
    "ts-node": "^10.4.0",
    "tsx": "^4.20.6",
    "typescript": "~5.8.2"
  }
}